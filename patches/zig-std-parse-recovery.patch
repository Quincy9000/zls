+fn bracesBalanced(p: *Parse) bool {
+    if (p.braces_balanced) |balanced| return balanced;
+    var level: usize = 0;
+    const balanced = for (p.tokens.items(.tag)) |tag| {
+        switch (tag) {
+            .l_brace => level += 1,
+            .r_brace => {
+                if (level == 0) break false;
+                level -= 1;
+            },
+            else => {},
+        }
+    } else level == 0;
+    p.braces_balanced = balanced;
+    return balanced;
+}
