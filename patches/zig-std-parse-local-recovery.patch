+fn bracesBalanced(p: *Parse) bool {
+    if (p.braces_balanced) |balanced| return balanced;
+    var level: usize = 0;
+    const balanced = for (p.tokens.items(.tag)) |tag| {
+        switch (tag) {
+            .l_brace => level += 1,
+            .r_brace => {
+                if (level == 0) break false;
+                level -= 1;
+            },
+            else => {},
+        }
+    } else level == 0;
+    p.braces_balanced = balanced;
+    return balanced;
+}
+
+/// Called when an element of a `{ ... }` list (an init list or switch prongs) fails to
+/// parse. Skips from the start of the element to the `,` or `}` that ends it, so the
+/// error stays inside the list. Otherwise it escapes to the enclosing statement, whose
+/// recovery doesn't know the list's `{` was opened and takes its `}` for the end of the
+/// block. That `}` can only be trusted when the file's braces balance; if they don't,
+/// the unclosed brace is likely in this list, and the error is passed on as before.
+fn recoverListElement(p: *Parse, element_start: TokenIndex) error{ParseError}!void {
+    if (!p.bracesBalanced()) return error.ParseError;
+    const error_tok = p.tok_i;
+    p.tok_i = element_start;
+    var braces: u32 = 0;
+    var parens_and_brackets: u32 = 0;
+    while (true) : (p.tok_i += 1) {
+        switch (p.tokenTag(p.tok_i)) {
+            .l_brace => braces += 1,
+            .r_brace => {
+                if (braces == 0) return;
+                braces -= 1;
+            },
+            .l_paren, .l_bracket => parens_and_brackets += 1,
+            .r_paren, .r_bracket => parens_and_brackets -|= 1,
+            .comma => if (braces == 0 and parens_and_brackets == 0) return,
+            .eof => {
+                p.tok_i = error_tok;
+                return error.ParseError;
+            },
+            else => {},
+        }
+    }
+}
